---
import Logo from '../atoms/Logo.tsx';
import LocaleLinks from '../molecules/LocaleLinks.astro';
import { AnimatedThemeToggler } from '../ui/animated-theme-toggler';
import { ArrowRight, Check } from 'lucide-react';
import type { Locale } from '../../i18n';
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  locale: Locale;
  copy: LandingCopy;
}

const { locale, copy } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="mulai" class="scroll-mt-24 border-t border-paper-300 bg-petrol-50/70 dark:bg-paper-100">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-20">
      <div>
        <p class="text-xs font-medium text-petrol-700">{copy.weekEyebrow}</p>
        <h2
          class="mt-4 max-w-xl text-3xl leading-[1.1] font-semibold tracking-[-0.035em] text-balance text-ink-900 sm:text-4xl"
        >
          {copy.ctaHeading}
        </h2>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-ink-600 sm:text-base">
          {copy.ctaBody}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/register"
            class="inline-flex h-11 items-center justify-center rounded-lg bg-petrol-600 px-5 text-sm font-medium text-onaccent shadow-sm shadow-petrol-600/20 transition-colors hover:bg-petrol-700"
          >
            {copy.footerCta}
          </a>
          <a
            href="/login"
            class="inline-flex h-11 items-center justify-center rounded-lg bg-paper-50 px-5 text-sm font-medium text-ink-800 ring-1 ring-paper-300 transition-colors hover:bg-paper-200 hover:text-ink-900 dark:ring-paper-400"
          >
            {copy.signInCta}
          </a>
        </div>

        <p class="mt-8 max-w-lg border-t border-paper-300 pt-5 text-xs leading-relaxed text-ink-600">
          {copy.footerNote}
        </p>
      </div>

      <div
        class="rounded-2xl border border-paper-300/80 bg-paper-50 p-6 shadow-sm sm:p-8 dark:border-paper-400/40"
      >
        <span class="inline-flex items-center gap-2 rounded-full bg-mint-100 px-3 py-1 text-xs font-semibold text-mint-600">
          <span class="size-1.5 rounded-full bg-mint-600" aria-hidden="true" />
          {copy.todayLabel}
        </span>
        <h3 class="mt-4 text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">
          {copy.footerCardTitle}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          {copy.ctaBody}
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <div class="flex items-center gap-2.5 text-xs font-medium text-ink-700">
            <span class="flex size-5 items-center justify-center rounded-full bg-petrol-100 text-petrol-700 dark:bg-petrol-900/50 dark:text-paper-50">
              <Check className="size-3" aria-hidden="true" strokeWidth={2.5} />
            </span>
            <span class="text-ink-800">{copy.views[0]?.title ?? 'Alur kerja visual'}</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs font-medium text-ink-700">
            <span class="flex size-5 items-center justify-center rounded-full bg-petrol-100 text-petrol-700 dark:bg-petrol-900/50 dark:text-paper-50">
              <Check className="size-3" aria-hidden="true" strokeWidth={2.5} />
            </span>
            <span class="text-ink-800">{copy.views[1]?.title ?? 'Tenggat waktu terkelola'}</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs font-medium text-ink-700">
            <span class="flex size-5 items-center justify-center rounded-full bg-petrol-100 text-petrol-700 dark:bg-petrol-900/50 dark:text-paper-50">
              <Check className="size-3" aria-hidden="true" strokeWidth={2.5} />
            </span>
            <span class="text-ink-800">{copy.views[2]?.title ?? 'Bebas distraksi & notifikasi'}</span>
          </div>
        </div>

        <div class="mt-8">
          <a
            href="/register"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-petrol-600 px-5 py-3 text-sm font-semibold text-white shadow-xs transition hover:bg-petrol-700 active:scale-[0.98]"
          >
            {copy.footerCta}
            <ArrowRight className="size-4" aria-hidden="true" strokeWidth={2} />
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-5 border-t border-paper-300 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <Logo />
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] font-medium text-ink-400">
          {copy.localeEyebrow}
        </span>
        <LocaleLinks current={locale} />
        <AnimatedThemeToggler
          client:load
          storageKey="trackora.v1.theme"
          label={copy.themeLabel}
          variant="circle"
          duration={450}
          title={copy.themeLabel}
          className="inline-flex size-11 items-center justify-center rounded-lg border border-paper-300 bg-paper-50 text-ink-600 transition-colors hover:bg-paper-100 hover:text-ink-900 dark:border-paper-400"
        />
      </div>
      <p class="text-xs text-ink-600">© {year} Trackora</p>
    </div>
  </div>
</footer>
